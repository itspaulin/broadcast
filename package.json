{
  "name": "broadcast",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "functions",
    "tests"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "emulators": "firebase emulators:start --only auth,firestore,functions --import .emulator-data --export-on-exit",
    "dev": "npm run build -w functions && concurrently -k -n functions,emulators,scheduler,web -c blue,magenta,yellow,green \"npm run build:watch -w functions\" \"npm run emulators\" \"npm run dev:scheduler -w functions\" \"npm run dev -w web\"",
    "lint": "oxlint --deny-warnings",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "npm run test:unit -w tests",
    "test:rules": "npm run test:rules -w tests",
    "test:functions": "npm run test:functions -w tests"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.86.0"
  }
}
